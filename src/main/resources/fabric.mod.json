{
	"schemaVersion": 1,
	"id": "eyeball",
	"version": "${version}",
	"name": "Googly Goobers",
	"description": "Gives every player huge 3D googly eyes, bouncy cartoon eyebrows and a talking mouth. Faces swell up when players chat or speak, go wild when they scream, and getting hit turns the eyes into spinning spirals with orbiting stars.",
	"authors": [
		"NotTorzz"
	],
	"contact": {
		"homepage": "https://github.com/torzzzzzzzz/Googly-Goobers---By-NotTorzz",
		"sources": "https://github.com/torzzzzzzzz/Googly-Goobers---By-NotTorzz",
		"issues": "https://github.com/torzzzzzzzz/Googly-Goobers---By-NotTorzz/issues"
	},
	"icon": "assets/eyeball/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.nottorzz.eyeball.EyeBallMod"
		],
		"client": [
			"com.nottorzz.eyeball.client.EyeBallClient"
		],
		"modmenu": [
			"com.nottorzz.eyeball.client.compat.ModMenuIntegration"
		],
		"voicechat": [
			"com.nottorzz.eyeball.compat.voice.EyeBallVoicechatPlugin"
		]
	},
	"mixins": [
		{
			"config": "eyeball.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_version}",
		"fabric-api": "${fabric_api_dependency}"
	},
	"suggests": {
		"modmenu": "*",
		"voicechat": "*"
	}
}
